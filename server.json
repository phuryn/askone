{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.phuryn/askone",
  "title": "AskOne",
  "description": "Run AskOne live Q&A and polls with free AI moderation: start rooms, launch polls, draft a FAQ.",
  "version": "1.2.3",
  "websiteUrl": "https://askone.org",
  "repository": {
    "url": "https://github.com/phuryn/askone",
    "source": "github"
  },
  "icons": [
    {
      "src": "https://askone.org/icon.svg",
      "mimeType": "image/svg+xml"
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "identifier": "askone-mcp",
      "version": "1.2.3",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "ASKONE_API_TOKEN",
          "description": "AskOne API token (organization admin: Manage → API tokens)",
          "isRequired": true,
          "isSecret": true,
          "format": "string"
        },
        {
          "name": "ASKONE_URL",
          "description": "Only for a self-hosted AskOne",
          "isRequired": false,
          "isSecret": false,
          "format": "string",
          "default": "https://askone.org"
        }
      ]
    },
    {
      "registryType": "mcpb",
      "identifier": "https://github.com/phuryn/askone/releases/download/v1.2.3/askone.mcpb",
      "fileSha256": "9d7028614abf86258ad918f83bdf589b10bae367dfce1c11ab1ae57f5f243676",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "ASKONE_API_TOKEN",
          "description": "AskOne API token (organization admin: Manage → API tokens)",
          "isRequired": true,
          "isSecret": true,
          "format": "string"
        },
        {
          "name": "ASKONE_URL",
          "description": "Only for a self-hosted AskOne",
          "isRequired": false,
          "isSecret": false,
          "format": "string",
          "default": "https://askone.org"
        }
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://askone.org/api/mcp",
      "headers": [
        {
          "name": "Authorization",
          "description": "AskOne API token (organization admin: Manage → API tokens). Optional: clients that support OAuth sign in with an AskOne account instead",
          "value": "Bearer {askone_api_token}",
          "isRequired": false,
          "isSecret": true,
          "variables": {
            "askone_api_token": {
              "description": "AskOne API token",
              "isRequired": true,
              "isSecret": true
            }
          }
        }
      ]
    }
  ]
}
